{
  "name": "@sfos/runtime-host",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal SmartFactory OS runtime composition host.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sfos-runtime-host": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "clean": "rimraf dist .turbo",
    "start": "node ./dist/cli.js",
    "cli": "node ./dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sfos/core": "workspace:*",
    "@sfos/db": "workspace:*",
    "@sfos/iam": "workspace:*",
    "@sfos/module-sdk": "workspace:*"
  },
  "devDependencies": {
    "@sfos/eslint-config": "workspace:*",
    "@sfos/tsconfig": "workspace:*",
    "@types/node": "^20.16.10",
    "postgres": "^3.4.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0"
  }
}
